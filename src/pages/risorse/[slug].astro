---
import { getCollection, render } from 'astro:content';
import { YouTube } from 'astro-embed';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { TARGET_META, TARGET_PAGE } from '@/lib/target-meta';

export async function getStaticPaths() {
  const entries = await getCollection('risorse');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta = TARGET_META[d.target];
const targetPage = TARGET_PAGE[d.target];

function markdownToPlainText(md: string): string {
  return md
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!\[[^\]]*\]\([^)]+\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/^\s*[-*+]\s+/gm, '')
    .replace(/^\s*\d+\.\s+/gm, '')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

const SITE_URL = 'https://finanzafuturo.it';
const thumb = d.thumbnail ?? `https://img.youtube.com/vi/${d.youtubeId}/maxresdefault.jpg`;
const transcriptText = markdownToPlainText(entry.body ?? '');

const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: d.title,
  description: d.excerpt,
  thumbnailUrl: thumb,
  uploadDate: d.publishedAt.toISOString(),
  duration: d.durationISO,
  embedUrl: `https://www.youtube.com/embed/${d.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${d.youtubeId}`,
  publisher: {
    '@type': 'Organization',
    name: 'Finanza & Futuro',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/finanza-futuro-logo.png`,
    },
  },
  transcript: transcriptText,
};

const others = (await getCollection('risorse'))
  .filter((e) => e.id !== entry.id && e.data.target === d.target)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);

const formattedDate = d.publishedAt.toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={d.title}
  description={d.excerpt}
  canonicalPath={`/risorse/${entry.id}`}
>
  <Header />
  <main class="flex-grow">
    <section class="bg-gradient-primary text-primary-foreground py-12 lg:py-16">
      <div class="container-wealth max-w-4xl mx-auto">
        <a
          href="/risorse"
          class="text-sm text-primary-foreground/70 hover:text-primary-foreground inline-flex items-center gap-1 mb-4"
        >
          ← Tutte le risorse
        </a>
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${meta.classes}`}>
            {meta.label}
          </span>
          <span
            class="text-sm text-primary-foreground/70 inline-flex items-center gap-1"
          >
            <Icon name="lucide:clock" class="w-4 h-4" />
            {d.duration}
          </span>
          <span class="text-sm text-primary-foreground/70">{formattedDate}</span>
        </div>
        <h1 class="text-3xl lg:text-5xl font-heading font-bold mb-4 leading-tight">
          {d.title}
        </h1>
        <p class="text-lg text-primary-foreground/80">{d.excerpt}</p>
      </div>
    </section>

    <section class="bg-background py-8">
      <div class="container-wealth max-w-4xl mx-auto">
        <div class="rounded-2xl overflow-hidden shadow-elegant">
          <YouTube id={d.youtubeId} title={d.title} />
        </div>
      </div>
    </section>

    <section class="section-padding bg-background">
      <div class="container-wealth max-w-4xl mx-auto">
        <div class="card-accent mb-12">
          <h2 class="font-heading text-xl font-bold mb-4 flex items-center gap-2">
            <Icon name="lucide:check-circle" class="w-5 h-5 text-accent" />
            Punti chiave
          </h2>
          <ul class="space-y-3">
            {
              d.takeaway.map((t) => (
                <li class="flex items-start gap-3">
                  <Icon
                    name="lucide:check-circle"
                    class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                  />
                  <span class="text-foreground">{t}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <article
          class="text-foreground leading-relaxed [&_h2]:text-2xl [&_h2]:font-heading [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-3 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:mb-4 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4 [&_li]:mb-1"
        >
          <Content />
        </article>
      </div>
    </section>

    <section class="section-padding bg-muted/30">
      <div class="container-wealth max-w-3xl mx-auto text-center">
        <h2 class="text-2xl lg:text-3xl font-heading font-bold mb-4">
          Se questo argomento ti riguarda
        </h2>
        <p class="text-muted-foreground mb-8">
          Approfondisci il nostro approccio dedicato o scrivici per una valutazione gratuita.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={targetPage} class="btn-primary">
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
            Scopri il percorso {meta.label}
          </a>
          <a
            href="https://wa.me/393396005487"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent"
          >
            <Icon name="lucide:calendar" class="w-4 h-4" />
            Prenota call gratuita
          </a>
        </div>
      </div>
    </section>

    {
      others.length > 0 && (
        <section class="section-padding bg-background border-t border-border">
          <div class="container-wealth">
            <h2 class="text-2xl lg:text-3xl font-heading font-bold mb-8 text-center">
              Altri video {meta.label}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
              {others.map((e) => {
                const otherThumb =
                  e.data.thumbnail ??
                  `https://img.youtube.com/vi/${e.data.youtubeId}/maxresdefault.jpg`;
                return (
                  <a
                    href={`/risorse/${e.id}`}
                    class="group card-wealth p-0 overflow-hidden flex flex-col"
                  >
                    <div class="relative aspect-video bg-muted overflow-hidden">
                      <img
                        src={otherThumb}
                        alt={e.data.title}
                        loading="lazy"
                        onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${e.data.youtubeId}/hqdefault.jpg'`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                      <span class="absolute bottom-2 right-2 px-2 py-1 bg-black/70 text-white text-xs rounded">
                        {e.data.duration}
                      </span>
                    </div>
                    <div class="p-6">
                      <h3 class="font-heading font-bold text-lg mb-2 group-hover:text-accent transition-smooth">
                        {e.data.title}
                      </h3>
                      <p class="text-sm text-muted-foreground line-clamp-2">{e.data.excerpt}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />
</BaseLayout>
