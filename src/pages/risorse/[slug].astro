---
import { getCollection, render } from 'astro:content';
import { YouTube } from 'astro-embed';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { TARGET_META, TARGET_PAGE } from '@/lib/target-meta';
import { deriveEntry, markdownToPlainText } from '@/lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('risorse');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const derived = await deriveEntry(entry);
const meta = TARGET_META[d.target];
const targetPage = TARGET_PAGE[d.target];

const SITE_URL = 'https://finanzafuturo.it';
const transcriptText = markdownToPlainText((entry as { body?: string }).body ?? '');

const videoLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: derived.title,
  description: derived.excerpt,
  thumbnailUrl: derived.thumbnail,
  uploadDate: derived.publishedAt.toISOString(),
  embedUrl: `https://www.youtube.com/embed/${derived.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${derived.youtubeId}`,
  publisher: {
    '@type': 'Organization',
    name: 'Finanza & Futuro',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/finanza-futuro-logo.png`,
    },
  },
  transcript: transcriptText,
};
if (derived.durationISO) videoLd.duration = derived.durationISO;

const othersAll = (await getCollection('risorse')).filter(
  (e) => e.id !== entry.id && e.data.target === d.target
);
const othersEnriched = await Promise.all(
  othersAll.map(async (e) => ({ entry: e, derived: await deriveEntry(e) }))
);
const others = othersEnriched
  .sort((a, b) => b.derived.publishedAt.getTime() - a.derived.publishedAt.getTime())
  .slice(0, 2);

const formattedDate = derived.publishedAt.toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={derived.title}
  description={derived.excerpt}
  canonicalPath={`/risorse/${entry.id}`}
>
  <Header />
  <main class="flex-grow">
    <section class="bg-gradient-primary text-primary-foreground py-12 lg:py-16">
      <div class="container-wealth max-w-4xl mx-auto">
        <a
          href="/risorse"
          class="text-sm text-primary-foreground/70 hover:text-primary-foreground inline-flex items-center gap-1 mb-4"
        >
          ← Tutte le risorse
        </a>
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`inline-block px-2 py-0.5 rounded text-xs font-medium ${meta.classes}`}>
            {meta.label}
          </span>
          {
            derived.duration && (
              <span class="text-sm text-primary-foreground/70 inline-flex items-center gap-1">
                <Icon name="lucide:clock" class="w-4 h-4" />
                {derived.duration}
              </span>
            )
          }
          <span class="text-sm text-primary-foreground/70">{formattedDate}</span>
        </div>
        <h1 class="text-3xl lg:text-5xl font-heading font-bold mb-4 leading-tight">
          {derived.title}
        </h1>
        <p class="text-lg text-primary-foreground/80">{derived.excerpt}</p>
      </div>
    </section>

    <section class="bg-background py-8">
      <div class="container-wealth max-w-4xl mx-auto">
        <div class="rounded-2xl overflow-hidden shadow-elegant">
          <YouTube id={derived.youtubeId} title={derived.title} />
        </div>
      </div>
    </section>

    <section class="section-padding bg-background">
      <div class="container-wealth max-w-4xl mx-auto">
        <div class="card-accent mb-12">
          <h2 class="font-heading text-xl font-bold mb-4 flex items-center gap-2">
            <Icon name="lucide:check-circle" class="w-5 h-5 text-accent" />
            Punti chiave
          </h2>
          <ul class="space-y-3">
            {
              d.takeaway.map((t) => (
                <li class="flex items-start gap-3">
                  <Icon
                    name="lucide:check-circle"
                    class="w-5 h-5 text-accent flex-shrink-0 mt-0.5"
                  />
                  <span class="text-foreground">{t}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <article
          class="text-foreground leading-relaxed [&_h2]:text-2xl [&_h2]:font-heading [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-3 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:mb-4 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:mb-4 [&_li]:mb-1"
        >
          <Content />
        </article>
      </div>
    </section>

    <section class="section-padding bg-muted/30">
      <div class="container-wealth max-w-3xl mx-auto text-center">
        <h2 class="text-2xl lg:text-3xl font-heading font-bold mb-4">
          Se questo argomento ti riguarda
        </h2>
        <p class="text-muted-foreground mb-8">
          Approfondisci il nostro approccio dedicato o scrivici per una valutazione gratuita.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={targetPage} class="btn-primary">
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
            Scopri il percorso {meta.label}
          </a>
          <a
            href="https://wa.me/393396005487"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-accent"
          >
            <Icon name="lucide:calendar" class="w-4 h-4" />
            Prenota call gratuita
          </a>
        </div>
      </div>
    </section>

    {
      others.length > 0 && (
        <section class="section-padding bg-background border-t border-border">
          <div class="container-wealth">
            <h2 class="text-2xl lg:text-3xl font-heading font-bold mb-8 text-center">
              Altri video {meta.label}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
              {others.map(({ entry: e, derived: dd }) => (
                <a
                  href={`/risorse/${e.id}`}
                  class="group card-wealth p-0 overflow-hidden flex flex-col"
                >
                  <div class="relative aspect-video bg-muted overflow-hidden">
                    <img
                      src={dd.thumbnail}
                      alt={dd.title}
                      loading="lazy"
                      onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${dd.youtubeId}/hqdefault.jpg'`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    {dd.duration && (
                      <span class="absolute bottom-2 right-2 px-2 py-1 bg-black/70 text-white text-xs rounded">
                        {dd.duration}
                      </span>
                    )}
                  </div>
                  <div class="p-6">
                    <h3 class="font-heading font-bold text-lg mb-2 group-hover:text-accent transition-smooth">
                      {dd.title}
                    </h3>
                    <p class="text-sm text-muted-foreground line-clamp-2">{dd.excerpt}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />
</BaseLayout>
