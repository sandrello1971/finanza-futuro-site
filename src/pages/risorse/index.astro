---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { TARGET_META } from '@/lib/target-meta';
import { deriveEntry } from '@/lib/content';

const all = await getCollection('risorse');
const enriched = await Promise.all(
  all.map(async (entry) => ({ entry, derived: await deriveEntry(entry) }))
);
const sorted = enriched.sort(
  (a, b) => b.derived.publishedAt.getTime() - a.derived.publishedAt.getTime()
);
---

<BaseLayout
  title="Risorse e video di educazione finanziaria"
  description="Video di educazione finanziaria con trascrizione completa: RSU, post-exit, family office, tax planning. Approccio evidence-based, contenuti tecnici."
  canonicalPath="/risorse"
>
  <Header />
  <main class="flex-grow">
    <section class="bg-gradient-primary text-primary-foreground py-16 lg:py-24">
      <div class="container-wealth">
        <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-4">Risorse</h1>
        <p class="text-xl text-accent italic mb-2">Educhiamo per proteggere il tuo patrimonio</p>
        <p class="text-lg text-primary-foreground/80 max-w-2xl leading-relaxed">
          Video di educazione finanziaria con trascrizione completa di ogni episodio.
          Argomenti tecnici, evidence-based, senza pressione commerciale.
        </p>
        <div class="mt-6">
          <a
            href="/risorse/rss.xml"
            class="inline-flex items-center gap-2 text-sm text-primary-foreground/70 hover:text-accent transition-smooth"
          >
            <Icon name="lucide:rss" class="w-4 h-4" />
            Feed RSS
          </a>
        </div>
      </div>
    </section>

    <section class="py-8 bg-muted/30 border-b border-border">
      <div class="container-wealth flex flex-wrap items-center gap-3">
        <span class="text-sm text-muted-foreground mr-2">Filtra:</span>
        <a
          href="/risorse"
          class="px-4 py-2 rounded-full bg-foreground text-background text-sm font-medium"
        >
          Tutti
        </a>
        {
          Object.entries(TARGET_META)
            .filter(([key]) => key !== 'famiglie-hnwi')
            .map(([key, m]) => (
              <a
                href={`/risorse/target/${key}`}
                class="px-4 py-2 rounded-full bg-background border border-border text-sm hover:border-accent transition-smooth"
              >
                {m.label}
              </a>
            ))
        }
      </div>
    </section>

    <section class="section-padding bg-background">
      <div class="container-wealth">
        {
          sorted.length === 0 ? (
            <div class="max-w-2xl mx-auto text-center py-12 px-6 bg-muted/30 rounded-2xl border border-border">
              <Icon name="lucide:rss" class="w-12 h-12 text-muted-foreground/50 mx-auto mb-4" />
              <h2 class="text-xl font-heading font-bold mb-3">Stiamo per pubblicare</h2>
              <p class="text-muted-foreground mb-6 leading-relaxed">
                I primi video di educazione finanziaria saranno pubblicati a breve.
                Iscriviti al{' '}
                <a href="/risorse/rss.xml" class="text-accent hover:underline">feed RSS</a>{' '}
                oppure lasciaci la tua mail per essere avvisato.
              </p>
              <a href="/contatti" class="btn-primary">
                <Icon name="lucide:mail" class="w-4 h-4" />
                Iscriviti agli aggiornamenti
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {sorted.map(({ entry, derived }) => {
                const m = TARGET_META[entry.data.target];
                return (
                  <a
                    href={`/risorse/${entry.id}`}
                    class="group card-wealth p-0 overflow-hidden flex flex-col"
                  >
                    <div class="relative aspect-video bg-muted overflow-hidden">
                      <img
                        src={derived.thumbnail}
                        alt={derived.title}
                        loading="lazy"
                        onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${derived.youtubeId}/hqdefault.jpg'`}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                        <Icon
                          name="lucide:play-circle"
                          class="w-16 h-16 text-white/90 drop-shadow-lg"
                        />
                      </div>
                      {derived.duration && (
                        <span class="absolute bottom-2 right-2 px-2 py-1 bg-black/70 text-white text-xs rounded">
                          {derived.duration}
                        </span>
                      )}
                    </div>
                    <div class="p-6 flex flex-col flex-grow">
                      <span
                        class={`inline-block px-2 py-0.5 rounded text-xs font-medium mb-3 self-start ${m.classes}`}
                      >
                        {m.label}
                      </span>
                      <h2 class="font-heading font-bold text-lg mb-2 group-hover:text-accent transition-smooth">
                        {derived.title}
                      </h2>
                      <p class="text-sm text-muted-foreground line-clamp-3 flex-grow">
                        {derived.excerpt}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
