---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Icon } from 'astro-icon/components';

const challenges = [
  'Gestione dei benefit e stock option aziendali',
  'Ottimizzazione fiscale di bonus e incentivi variabili',
  "Diversificazione del patrimonio oltre l'azienda",
  'Pianificazione successoria e protezione patrimoniale',
  'Gestione della liquidità da exit o IPO',
];

const solutions = [
  {
    icon: 'lucide:trending-up',
    title: 'Gestione Patrimoniale Integrata',
    description:
      'Coordiniamo i tuoi investimenti personali con i benefit aziendali per massimizzare il rendimento complessivo.',
  },
  {
    icon: 'lucide:shield',
    title: 'Ottimizzazione Fiscale e Gestione del Rischio Assicurativo',
    description:
      "Strutture legali per minimizzare l'impatto fiscale su stock option, bonus e altri strumenti di incentivazione. Gestione del rischio intrinseco e armonizzazione fiscale attraverso strumenti assicurativi.",
  },
  {
    icon: 'lucide:users',
    title: 'Advisory Strategico',
    description:
      'Supporto nelle decisioni di carriera che impattano il patrimonio: cambio azienda, promozioni, opportunità di equity.',
  },
];
---

<BaseLayout
  title="Consulenza patrimoniale per Dirigenti & Professionisti"
  description="Gestione patrimoniale per dirigenti e professionisti con €300K-€1,5M: stock option, RSU, bonus, ottimizzazione fiscale e diversificazione. Advisory specializzato a Milano."
  pageType="Service"
  canonicalPath="/dirigenti"
>
  <Header />
  <main class="flex-grow">
    <!-- Hero -->
    <section class="bg-gradient-primary text-primary-foreground py-20 lg:py-32">
      <div class="container-wealth">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div
              class="inline-flex items-center px-4 py-2 rounded-full bg-primary-foreground/10 border border-primary-foreground/20 mb-8"
            >
              <span class="text-sm font-medium">Per Dirigenti &amp; Professionisti</span>
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
              Gestione patrimoniale per
              <span class="text-accent">dirigenti</span>
              e
              <span class="text-accent">professionisti</span>
            </h1>
            <p class="text-xl lg:text-2xl mb-8 text-primary-foreground/80 leading-relaxed">
              Soluzioni specifiche per chi ha patrimoni complessi derivanti da carriere di successo,
              stock option e benefit aziendali.
            </p>
            <a
              href="https://wa.me/393396005487"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-on-dark"
            >
              <Icon name="lucide:calendar" class="w-5 h-5" />
              Prenota consulenza specializzata
            </a>
          </div>
          <div class="flex justify-center">
            <div class="relative">
              <div
                class="absolute -top-4 -left-4 w-72 h-72 bg-accent/20 rounded-full blur-3xl"
                aria-hidden="true"
              >
              </div>
              <div
                class="relative z-10 w-80 h-80 bg-primary-foreground/10 rounded-2xl flex items-center justify-center border border-primary-foreground/20"
              >
                <Icon name="lucide:target" class="w-32 h-32 text-primary-foreground/60" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sfide -->
    <section class="section-padding bg-background">
      <div class="container-wealth">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-heading font-bold text-foreground mb-6">
            Le sfide patrimoniali dei dirigenti
          </h2>
          <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
            Ogni dirigente e professionista di successo affronta sfide uniche nella gestione del
            proprio patrimonio
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            challenges.map((challenge) => (
              <div class="card-wealth">
                <div class="flex items-start space-x-4">
                  <Icon
                    name="lucide:check-circle"
                    class="w-6 h-6 text-accent flex-shrink-0 mt-1"
                  />
                  <p class="text-foreground font-medium">{challenge}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Soluzioni -->
    <section class="section-padding bg-muted/30">
      <div class="container-wealth">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-heading font-bold text-foreground mb-6">
            Le nostre soluzioni specifiche
          </h2>
          <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
            Approccio personalizzato per dirigenti con patrimoni complessi e esigenze sofisticate
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            solutions.map((solution) => (
              <div class="card-wealth text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-accent/10 rounded-full mb-6">
                  <Icon name={solution.icon} class="w-8 h-8 text-accent" />
                </div>
                <h3 class="text-xl font-heading font-bold text-foreground mb-4">
                  {solution.title}
                </h3>
                <p class="text-muted-foreground leading-relaxed">{solution.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding bg-background">
      <div class="container-wealth text-center">
        <h2 class="text-3xl lg:text-4xl font-heading font-bold text-foreground mb-6">
          Pronto a ottimizzare il tuo patrimonio professionale?
        </h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Parliamo delle tue esigenze specifiche e di come possiamo aiutarti a massimizzare il
          valore del tuo patrimonio
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://wa.me/393396005487"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            <Icon name="lucide:calendar" class="w-5 h-5" />
            Prenota valutazione gratuita
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
