---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { Icon } from 'astro-icon/components';

const FORMSPREE_ID = '[FORMSPREE_ID]';
const SITE_URL = 'https://www.finanzafuturo.it';
---

<BaseLayout
  title="Contatti — Prenota la tua valutazione gratuita"
  description="Prenota una valutazione patrimoniale gratuita di 30 minuti. Form di contatto riservato, risposta entro 24 ore lavorative."
  canonicalPath="/contatti"
>
  <Header />
  <main class="flex-grow">
    <section class="bg-gradient-primary text-primary-foreground py-12 lg:py-20">
      <div class="container-wealth max-w-4xl mx-auto text-center">
        <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-4 leading-tight">
          Prenota la tua valutazione gratuita
        </h1>
        <p class="text-lg lg:text-xl text-primary-foreground/80 max-w-2xl mx-auto">
          30 minuti per capire come lavoriamo. Nessun impegno, riservatezza garantita.
        </p>
      </div>
    </section>

    <section class="section-padding bg-background">
      <div class="container-wealth">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 max-w-6xl mx-auto">
          <div class="lg:col-span-2">
            <form
              action={`https://formspree.io/f/${FORMSPREE_ID}`}
              method="POST"
              class="card-wealth space-y-6"
            >
              <input
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="hidden"
              />
              <input type="hidden" name="_next" value={`${SITE_URL}/contatti/grazie`} />
              <input
                type="hidden"
                name="_subject"
                value="Nuova richiesta valutazione gratuita — finanzafuturo.it"
              />

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="nome" class="block text-sm font-medium text-foreground mb-2">
                    Nome e cognome <span class="text-destructive">*</span>
                  </label>
                  <input
                    id="nome"
                    name="nome"
                    type="text"
                    required
                    autocomplete="name"
                    class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-smooth"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-foreground mb-2">
                    Email <span class="text-destructive">*</span>
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-smooth"
                  />
                </div>
              </div>

              <div>
                <label for="telefono" class="block text-sm font-medium text-foreground mb-2">
                  Telefono <span class="text-muted-foreground text-xs">(opzionale)</span>
                </label>
                <input
                  id="telefono"
                  name="telefono"
                  type="tel"
                  autocomplete="tel"
                  class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-smooth"
                />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="profilo" class="block text-sm font-medium text-foreground mb-2">
                    Profilo
                  </label>
                  <select
                    id="profilo"
                    name="profilo"
                    class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-smooth"
                  >
                    <option value="">Seleziona…</option>
                    <option>Dirigente / Professionista</option>
                    <option>Imprenditore Post-Exit</option>
                    <option>Altro</option>
                  </select>
                </div>
                <div>
                  <label for="patrimonio" class="block text-sm font-medium text-foreground mb-2">
                    Patrimonio approssimativo
                  </label>
                  <select
                    id="patrimonio"
                    name="patrimonio"
                    class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-smooth"
                  >
                    <option value="">Preferisco non indicare</option>
                    <option>Sotto €300K</option>
                    <option>€300K – €1,5M</option>
                    <option>€1,5M – €5M</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="messaggio" class="block text-sm font-medium text-foreground mb-2">
                  Come possiamo aiutarti?
                </label>
                <textarea
                  id="messaggio"
                  name="messaggio"
                  rows="4"
                  class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition-smooth resize-y"
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  id="privacy"
                  name="privacy_consent"
                  type="checkbox"
                  required
                  class="mt-1 w-4 h-4 rounded border-border text-accent focus:ring-accent/20"
                />
                <label for="privacy" class="text-sm text-muted-foreground leading-relaxed">
                  Ho letto e accetto la
                  <a href="/privacy" class="text-accent hover:underline">Privacy Policy</a>.
                  <span class="text-destructive">*</span>
                </label>
              </div>

              <button type="submit" class="btn-primary w-full md:w-auto">
                <Icon name="lucide:arrow-right" class="w-4 h-4" />
                Richiedi valutazione gratuita
              </button>
            </form>
          </div>

          <aside class="space-y-6">
            <div class="card-accent">
              <h2 class="font-heading font-bold text-xl mb-6">Contatti diretti</h2>
              <div class="space-y-5">
                <div class="flex items-start gap-3">
                  <Icon name="lucide:mail" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
                  <div>
                    <div class="text-sm text-muted-foreground mb-1">Email</div>
                    <a
                      href="mailto:info@finanzafuturo.it"
                      class="text-foreground hover:text-accent transition-smooth break-all"
                    >
                      info@finanzafuturo.it
                    </a>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="lucide:phone" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
                  <div>
                    <div class="text-sm text-muted-foreground mb-1">Telefono</div>
                    <a
                      href="tel:+390249876530"
                      class="block text-foreground hover:text-accent transition-smooth"
                    >
                      02 4987653
                    </a>
                    <a
                      href="tel:+393396005487"
                      class="block text-foreground hover:text-accent transition-smooth"
                    >
                      339 6005487
                    </a>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="lucide:map-pin" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" />
                  <div>
                    <div class="text-sm text-muted-foreground mb-1">Sede</div>
                    <div class="text-foreground">
                      Via Alberto da Giussano 17<br />20145 Milano
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-muted/30 border border-border rounded-2xl p-5 text-sm">
              <p class="text-muted-foreground mb-3">Hai bisogno di una risposta veloce?</p>
              <a
                href="https://wa.me/393396005487"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-foreground hover:text-accent transition-smooth font-medium"
              >
                <Icon name="lucide:calendar" class="w-4 h-4" />
                Scrivici su WhatsApp
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
