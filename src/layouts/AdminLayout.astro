---
interface Props {
  title: string;
  user?: string;
}
const { title, user } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Admin · Finanza & Futuro</title>
    <link rel="stylesheet" href="/global.css" />
    <style is:global>
      :root {
        color-scheme: light;
      }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        background: #f4f4f5;
        color: #18181b;
      }
      .admin-shell {
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }
      .admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 16px;
        border-bottom: 1px solid #e4e4e7;
        margin-bottom: 28px;
      }
      .admin-header h1 {
        font-size: 20px;
        margin: 0;
        font-weight: 600;
      }
      .admin-card {
        background: #fff;
        border: 1px solid #e4e4e7;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      }
      label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #3f3f46;
        margin-bottom: 6px;
        margin-top: 18px;
      }
      label:first-of-type {
        margin-top: 0;
      }
      input[type='text'],
      input[type='url'],
      input[type='password'],
      input[type='email'],
      textarea,
      select {
        width: 100%;
        box-sizing: border-box;
        font: inherit;
        font-size: 14px;
        padding: 10px 12px;
        border: 1px solid #d4d4d8;
        border-radius: 8px;
        background: #fff;
        color: #18181b;
      }
      textarea {
        resize: vertical;
        min-height: 80px;
      }
      input:focus,
      textarea:focus,
      select:focus {
        outline: 2px solid #2563eb;
        outline-offset: 0;
        border-color: #2563eb;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 18px;
        border-radius: 8px;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
      }
      .btn-primary {
        background: #18181b;
        color: #fff;
      }
      .btn-primary:hover {
        background: #27272a;
      }
      .btn-primary:disabled {
        background: #a1a1aa;
        cursor: not-allowed;
      }
      .btn-secondary {
        background: #fff;
        color: #18181b;
        border-color: #d4d4d8;
      }
      .btn-secondary:hover {
        background: #f4f4f5;
      }
      .alert {
        padding: 12px 14px;
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 18px;
      }
      .alert-error {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
      }
      .alert-success {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
      }
      .alert-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
      }
      .hint {
        font-size: 12px;
        color: #71717a;
        margin-top: 4px;
      }
      .row-takeaway {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
      }
      .row-takeaway input {
        flex: 1;
      }
      .row-takeaway button {
        background: #fff;
        border: 1px solid #d4d4d8;
        border-radius: 8px;
        padding: 0 12px;
        cursor: pointer;
        color: #71717a;
      }
      .actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
      }
      .user-chip {
        font-size: 13px;
        color: #52525b;
      }
      .user-chip form {
        display: inline;
      }
      .user-chip button {
        background: none;
        border: none;
        color: #2563eb;
        cursor: pointer;
        padding: 0;
        font: inherit;
        text-decoration: underline;
        margin-left: 8px;
      }
    </style>
  </head>
  <body>
    <div class="admin-shell">
      <div class="admin-header">
        <h1>Finanza &amp; Futuro · Admin</h1>
        {user ? (
          <span class="user-chip">
            {user}
            <form method="POST" action="/api/admin/logout">
              <button type="submit">Logout</button>
            </form>
          </span>
        ) : null}
      </div>
      <slot />
    </div>
  </body>
</html>
