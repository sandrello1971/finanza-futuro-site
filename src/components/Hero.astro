---
import { Icon } from 'astro-icon/components';

const proofPoints = [
  'Visione WorldWide',
  'Architettura aperta e verificabile',
  'Processo documentato e policy conflitti',
  'Riservatezza garantita',
];
---

<section class="relative overflow-hidden bg-gradient-primary text-primary-foreground">
  <!-- Pattern di sfondo -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/90 via-primary to-primary/95"></div>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_30%_80%,_hsl(var(--accent))_0%,_transparent_50%)] opacity-10"
  >
  </div>

  <div class="relative container-wealth py-20 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Contenuto -->
      <div class="text-center lg:text-left">
        <div
          class="inline-flex items-center px-4 py-2 rounded-full bg-primary-foreground/10 border border-primary-foreground/20 mb-8"
        >
          <span class="text-sm font-medium">Consulenza Patrimoniale Evoluta</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
          Consulenza patrimoniale
          <span class="text-accent font-bold">con regole chiare.</span>
          <br />
          Nessuna sorpresa.
        </h1>

        <p
          class="text-xl lg:text-2xl mb-4 text-accent font-medium italic"
        >
          Educhiamo per proteggere il tuo patrimonio
        </p>

        <p
          class="text-lg lg:text-xl mb-8 text-primary-foreground/80 max-w-2xl mx-auto lg:mx-0 leading-relaxed"
        >
          Advisory 100% umano per dirigenti e imprenditori post-exit.
          Trasparenza totale, competenza verificabile.
        </p>

        <!-- Proof Points -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 max-w-2xl mx-auto lg:mx-0">
          {
            proofPoints.map((point) => (
              <div class="flex items-center space-x-3 text-primary-foreground/90">
                <Icon name="lucide:check-circle" class="w-5 h-5 text-accent flex-shrink-0" />
                <span class="text-sm font-medium">{point}</span>
              </div>
            ))
          }
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
          <a
            href="/contatti"
            class="btn-on-dark"
          >
            <Icon name="lucide:calendar" class="w-5 h-5" />
            Prenota valutazione gratuita (30 min)
          </a>
        </div>

        <div class="mt-8 pt-8 border-t border-primary-foreground/20">
          <p class="text-sm text-primary-foreground/70">
            Oltre 25 anni di esperienza nei principali gruppi bancari nazionali e internazionali
          </p>
        </div>
      </div>

      <!-- Visual: logo grande al posto della foto -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <div
            class="absolute -top-4 -left-4 w-72 h-72 bg-accent/20 rounded-full blur-3xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="absolute -bottom-4 -right-4 w-48 h-48 bg-primary-foreground/20 rounded-full blur-2xl"
            aria-hidden="true"
          >
          </div>

          <div
            class="relative z-10 w-80 h-80 lg:w-96 lg:h-96 bg-primary-foreground/95 rounded-3xl shadow-elegant flex items-center justify-center p-12"
          >
            <img
              src="/images/finanza-futuro-logo.png"
              alt="Logo Finanza & Futuro"
              class="w-full h-full object-contain"
              width="384"
              height="384"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
