---
import { Icon } from 'astro-icon/components';
import MobileMenu from './MobileMenu.tsx';

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
---

<header class="bg-background/95 backdrop-blur-sm border-b border-border sticky top-0 z-50">
  <div class="container-wealth">
    <div class="flex justify-between items-center h-20 relative">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" aria-label="Finanza & Futuro - Home">
          <img
            src="/images/finanza-futuro-logo.png"
            alt="Finanza & Futuro"
            class="h-12 w-auto cursor-pointer hover:opacity-80 transition-smooth"
            width="120"
            height="48"
          />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8" aria-label="Navigazione principale">
        <a
          href="/"
          class={`text-wealth hover:text-foreground transition-smooth ${isActive('/') ? 'text-foreground font-medium' : ''}`}
        >
          Home
        </a>

        <div class="relative group">
          <span class="text-wealth cursor-pointer hover:text-foreground transition-smooth flex items-center gap-1">
            Per Chi
            <Icon name="lucide:arrow-right" class="w-3 h-3 rotate-90 opacity-60" />
          </span>
          <div
            class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-64 bg-card border border-border rounded-lg shadow-elegant opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50"
          >
            <div class="p-4 space-y-3">
              <a
                href="/dirigenti"
                class="block text-sm text-muted-foreground hover:text-foreground transition-smooth"
              >
                Dirigenti &amp; Professionisti
              </a>
              <a
                href="/post-exit"
                class="block text-sm text-muted-foreground hover:text-foreground transition-smooth"
              >
                Post-Exit
              </a>
            </div>
          </div>
        </div>

        <a
          href="/servizi"
          class={`text-wealth hover:text-foreground transition-smooth ${isActive('/servizi') ? 'text-foreground font-medium' : ''}`}
        >
          Servizi
        </a>
        <a
          href="/risorse"
          class={`text-wealth hover:text-foreground transition-smooth ${isActive('/risorse') ? 'text-foreground font-medium' : ''}`}
        >
          Risorse
        </a>
        <a
          href="/contatti"
          class={`text-wealth hover:text-foreground transition-smooth ${isActive('/contatti') ? 'text-foreground font-medium' : ''}`}
        >
          Contatti
        </a>
        <a
          href="/chi-siamo"
          class={`text-wealth hover:text-foreground transition-smooth ${isActive('/chi-siamo') ? 'text-foreground font-medium' : ''}`}
        >
          Chi Siamo
        </a>
      </nav>

      <!-- CTA desktop -->
      <div class="hidden lg:flex items-center space-x-4">
        <a
          href="https://wa.me/393396005487"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-accent !py-2 !px-4 text-sm"
        >
          <Icon name="lucide:calendar" class="w-4 h-4" />
          Prenota Call
        </a>
      </div>

      <!-- Mobile menu (React island) -->
      <MobileMenu client:load />
    </div>
  </div>
</header>
