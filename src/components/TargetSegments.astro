---
import { Icon } from 'astro-icon/components';

const segments = [
  {
    icon: 'lucide:briefcase',
    title: 'Dirigenti & Professionisti',
    subtitle: '€300K - €1,5M di patrimonio',
    pain: 'RSU, stock option, costi poco chiari?',
    benefit: 'Audit completo, consolidamento, reporting trasparente',
    href: '/dirigenti',
    color: 'from-accent/10 to-accent/5',
  },
  {
    icon: 'lucide:trending-up',
    title: 'Post-Exit',
    subtitle: '€1,5M - €5M da liquidità',
    pain: 'Pressure commerciale, costi nascosti, complessità?',
    benefit: 'Playbook 90 giorni, filtro metodico, roadmap fiscale',
    href: '/post-exit',
    color: 'from-primary/10 to-primary/5',
  },
];
---

<section class="section-padding subtle-gradient">
  <div class="container-wealth">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-heading font-bold mb-6 heading-wealth">
        Due percorsi specializzati
      </h2>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        Approcci specializzati per dirigenti e imprenditori post-exit. Chiarezza sui compensi,
        metodo trasparente.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        segments.map((segment) => (
          <div class="group">
            <div
              class={`card-wealth bg-gradient-to-br ${segment.color} hover:shadow-accent transition-all duration-500 group-hover:-translate-y-2 h-full flex flex-col`}
            >
              <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-background shadow-soft mb-4">
                  <Icon name={segment.icon} class="w-8 h-8 text-accent" />
                </div>
                <h3 class="text-xl font-heading font-bold mb-2">{segment.title}</h3>
                <p class="text-sm text-accent font-medium">{segment.subtitle}</p>
              </div>

              <div class="space-y-4 flex-grow">
                <div class="bg-destructive/5 border border-destructive/20 rounded-lg p-4">
                  <p class="text-sm font-medium text-destructive">❌ {segment.pain}</p>
                </div>
                <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
                  <p class="text-sm font-medium text-emerald-700">✅ {segment.benefit}</p>
                </div>
              </div>

              <div class="mt-6 pt-6 border-t border-border">
                <a
                  href={segment.href}
                  class="btn-ghost w-full justify-center group-hover:bg-accent/10"
                >
                  Scopri come possiamo aiutarti
                  <Icon
                    name="lucide:arrow-right"
                    class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                  />
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-12">
      <p class="text-muted-foreground">
        Non sei sicuro quale approccio fa per te?
        <a href="/contatti" class="text-accent font-medium hover:underline ml-1">
          Parliamone insieme
        </a>
      </p>
    </div>
  </div>
</section>
